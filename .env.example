# Copy to .env and fill in locally. NEVER commit .env.
#
# Secrets for CI belong in the repository's Actions secrets, not here:
#   KAGGLE_USERNAME / KAGGLE_KEY   -> workflow "dispatch-gpu"
#   HF_TOKEN                       -> workflow "ingest" (publish step)
# Repository variables (not secrets):
#   HF_REPO                        -> e.g. <user>/battery-field-canonical

# --- local paths ------------------------------------------------------------
BFA_DATA_DIR=./data
BFA_OUT_DIR=./out
BFA_STATE=./state/state.json

# --- artifact store (optional locally, required to publish) -----------------
HF_TOKEN=
HF_REPO=

# --- Kaggle (only needed to dispatch GPU work) ------------------------------
# Phone-verify the account first: accelerators are locked until you do.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- budget reminder (informational) ---------------------------------------
# Kaggle: 30 GPU-h/week, resets Sunday 00:00 UTC, counts WALL-CLOCK.
# Planned ceiling for this project: 20 h/week. See docs/04-quota-budget.md.
BFA_WEEKLY_GPU_CEILING_HOURS=20
